# Names only. Nothing here is needed for the local demo, and no script reads a .env file:
# export a variable in your shell (or pass it to docker compose) to use it.

# Mainnet RPC used read-only by scripts/dump-programs.ts to fetch the SAS and Squads binaries.
# Unset or empty means the public endpoint; a private one (Helius, Triton, QuickNode) avoids rate limits.
MAINNET_RPC_URL=
